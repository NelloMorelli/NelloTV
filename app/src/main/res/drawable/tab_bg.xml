<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="360"
    android:exitFadeDuration="360">
    <item android:state_focused="true">
        <shape><solid android:color="#F2FFFFFF" /><corners android:radius="20dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#2EFFFFFF" /><corners android:radius="20dp" /></shape>
    </item>
    <item><shape><solid android:color="#00000000" /><corners android:radius="20dp" /></shape></item>
</selector>
