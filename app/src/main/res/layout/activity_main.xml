<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <com.nello.tvhome.PageScroll
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- first screen: its height is set to the screen height in code -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- header: page title + text tabs on the left, clock in the centre, round buttons on the right -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="44dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.nello.tvhome.FocusGroup
                    android:id="@+id/tabGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabSearch"
                        style="@style/Tab"
                        android:contentDescription="Cerca"
                        android:maxLines="1"
                        android:text="⌕  Cerca"
                        android:textColor="@color/text_dim" />

                    <TextView
                        android:id="@+id/tabExplore"
                        style="@style/Tab"
                        android:text="Esplora"
                        android:textColor="@color/text_dim" />

                    <TextView
                        android:id="@+id/tabMovies"
                        style="@style/Tab"
                        android:text="Film"
                        android:textColor="@color/text_dim" />

                    <TextView
                        android:id="@+id/tabSeries"
                        style="@style/Tab"
                        android:text="Serie TV"
                        android:textColor="@color/text_dim" />

                    <TextView
                        android:id="@+id/tabSport"
                        style="@style/Tab"
                        android:text="Sport"
                        android:textColor="@color/text_dim" />
                </com.nello.tvhome.FocusGroup>
            </LinearLayout>

            <TextClock
                android:id="@+id/clockTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <!-- right menu: one glass pill, a white highlight slides between the icons -->
            <com.nello.tvhome.GlassView
                android:id="@+id/rightBar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:padding="4dp">

                <com.nello.tvhome.FocusGroup
                    android:id="@+id/barGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/vpnButton"
                        style="@style/BarIcon"
                        android:contentDescription="VPN">

                        <com.nello.tvhome.StatusIcon
                            android:id="@+id/vpnIcon"
                            style="@style/BarGlyph" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/netButton"
                        style="@style/BarIcon"
                        android:contentDescription="Connessione">

                        <com.nello.tvhome.StatusIcon
                            android:id="@+id/netIcon"
                            style="@style/BarGlyph" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/settingsButton"
                        style="@style/BarIcon"
                        android:contentDescription="Impostazioni">

                        <com.nello.tvhome.StatusIcon
                            android:id="@+id/gearIcon"
                            style="@style/BarGlyph" />
                    </FrameLayout>
                </com.nello.tvhome.FocusGroup>
            </com.nello.tvhome.GlassView>
        </FrameLayout>

        <!-- hero (Sport, Cerca): greeting or focused title -->
        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="178dp"
            android:paddingStart="48dp"
            android:paddingTop="18dp">

            <LinearLayout
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clockBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="76sp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/hello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <com.nello.tvhome.GlassView
                    android:id="@+id/searchGlass"
                    android:layout_width="560dp"
                    android:layout_height="48dp">

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/search_field"
                        android:hint="Cerca film, serie TV e app…"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:textSize="17sp" />
                </com.nello.tvhome.GlassView>

                    <!-- the search bar's second half: same glass, round, mic icon -->
                    <com.nello.tvhome.GlassView
                        android:id="@+id/voiceButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:contentDescription="Cerca con la voce"
                        android:focusable="true">

                        <com.nello.tvhome.StatusIcon
                            android:id="@+id/voiceIcon"
                            style="@style/BarGlyph" />
                    </com.nello.tvhome.GlassView>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/info"
                android:layout_width="480dp"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp">

                    <ImageView
                        android:id="@+id/infoLogo"
                        android:layout_width="280dp"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitStart" />

                    <TextView
                        android:id="@+id/infoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="bottom|start"
                        android:maxLines="2"
                        android:textColor="@color/text"
                        android:textSize="28sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/infoMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/infoOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.1"
                    android:maxLines="3"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:paddingBottom="260dp" />

        <!-- single screen (Esplora, Film, Serie TV): one carousel + dock -->
        <LinearLayout
            android:id="@+id/single"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/catalogLabel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="34dp"
                android:background="@drawable/tab_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/tab_text"
                android:textSize="15sp" />

            <com.nello.tvhome.RowList
                android:id="@+id/carousel"
                android:layout_width="match_parent"
                android:layout_height="234dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="44dp"
                android:paddingTop="12dp"
                android:paddingEnd="44dp"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/carouselTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="46dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/carouselMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="46dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.nello.tvhome.GlassView
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="22dp"
                android:clipChildren="false">

                <com.nello.tvhome.RowList
                    android:id="@+id/dockList"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp" />
            </com.nello.tvhome.GlassView>
        </LinearLayout>
    </LinearLayout>

    <!-- below the dock (Esplora only): Continua a guardare + all apps as a bento grid -->
    <LinearLayout
        android:id="@+id/below"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingBottom="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/continueTitle"
            style="@style/SectionTitle"
            android:text="Continua a guardare" />

        <com.nello.tvhome.RowList
            android:id="@+id/continueList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="10dp"
            android:paddingEnd="48dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/bentoTitle"
            style="@style/SectionTitle"
            android:text="Tutte le app" />

        <LinearLayout
            android:id="@+id/bento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp" />
    </LinearLayout>
    </LinearLayout>
    </com.nello.tvhome.PageScroll>

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/live_bg"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="Nessuna connessione a Internet · i contenuti si aggiorneranno appena torna la rete"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
